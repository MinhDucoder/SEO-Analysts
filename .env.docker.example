# ─── Database Credentials ───
GATEWAY_DB_USER=gateway_user
GATEWAY_DB_PASS=gateway_pass
GATEWAY_DB_NAME=seo_gateway

ANALYZER_DB_USER=analyzer_user
ANALYZER_DB_PASS=analyzer_pass
ANALYZER_DB_NAME=seo_analyzer

REPORT_DB_USER=report_user
REPORT_DB_PASS=report_pass
REPORT_DB_NAME=seo_report

# ─── Redis ───
REDIS_PASSWORD=redis-secret-change-in-production

# ─── JWT ───
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# ─── OAuth (leave empty for dev) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── Frontend ───
FRONTEND_URL=http://localhost:3001

# ── Public API LLM enrichment (Plan 2) ──────────────────────────────
# Leave ANTHROPIC_API_KEY unset to disable LLM enrichment; enrichMode=llm
# will degrade gracefully to template with meta.degraded=true.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=8000

# Subscriptions / VietQR / Casso
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
CASSO_WEBHOOK_SECRET=
BILLING_INTENT_TTL_MINUTES=30
BILLING_FEATURE_ENABLED=false
