# ─── Database Credentials ───
GATEWAY_DB_USER=gateway_user
GATEWAY_DB_PASS=gateway_pass
GATEWAY_DB_NAME=seo_gateway

ANALYZER_DB_USER=analyzer_user
ANALYZER_DB_PASS=analyzer_pass
ANALYZER_DB_NAME=seo_analyzer

REPORT_DB_USER=report_user
REPORT_DB_PASS=report_pass
REPORT_DB_NAME=seo_report

# ─── Redis ───
REDIS_PASSWORD=redis-secret-change-in-production

# ─── JWT ───
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# ─── Google OAuth ───
# Tao OAuth Client tai https://console.cloud.google.com/apis/credentials
# - Authorized redirect URI bat buoc: http://localhost:3000/api/v1/auth/google/callback
# - De trong se khien /api/v1/auth/google tra 503 (guard chan truoc khi vao Passport).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── Frontend ───
FRONTEND_URL=http://localhost:3001

# ── Public API LLM enrichment (Plan 2) ──────────────────────────────
# Leave ANTHROPIC_API_KEY unset to disable LLM enrichment; enrichMode=llm
# will degrade gracefully to template with meta.degraded=true.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Keep >=8192: /public/check (extension + CLI) sends ALL page issues in one
# LLM call; 2048 truncates the JSON for ~15+ issues -> parse fails -> degrade.
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_MS=8000

# ── AI issue suggestions (SEO_AI_* drives BOTH report + gateway /check) ──
# Per-rule AI fix suggestions. Set SEO_AI_ENABLED=true to enable (kill
# switch for both services). Provider: anthropic (reuses ANTHROPIC_API_KEY
# above) | gemini. docker-compose passes these to gateway + report.
SEO_AI_ENABLED=false
SEO_AI_PROVIDER=anthropic
SEO_AI_MODEL=claude-haiku-4-5
# GEMINI_API_KEY required only when SEO_AI_PROVIDER=gemini (model: gemini-2.0-flash)
GEMINI_API_KEY=

# Subscriptions / VietQR / Casso
VIETQR_BANK_BIN=970423
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
CASSO_WEBHOOK_SECRET=
BILLING_INTENT_TTL_MINUTES=30
BILLING_FEATURE_ENABLED=false
# Dev/demo only — auto-confirm pending intents. MUST stay false in production.
BILLING_DEV_AUTOCONFIRM=false
