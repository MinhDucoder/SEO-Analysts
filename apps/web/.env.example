# Gateway REST + WS (see apps/gateway/.env)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Report service HTTP (for direct PDF preview if needed)
NEXT_PUBLIC_REPORT_HTTP_URL=http://localhost:3004

# App metadata
NEXT_PUBLIC_APP_NAME=SEO Analyst
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional observability (leave blank in dev)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Dev-only: set to 1 to bypass AuthGuard + AdminGuard with a fake admin user.
# Only honored when NODE_ENV !== "production". Real API calls will still 401
# because the injected token is fake — useful for visual / layout testing only.
NEXT_PUBLIC_DEV_BYPASS_AUTH=
