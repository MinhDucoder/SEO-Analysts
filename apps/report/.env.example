REPORT_DATABASE_URL=postgresql://report_user:report_pass@localhost:5434/seo_report
REDIS_URL=redis://localhost:6379
GRPC_PORT=50055
HTTP_PORT=3004
NODE_ENV=development

# AI suggestions. Set SEO_AI_ENABLED=true to enable. Provider: anthropic|gemini.
SEO_AI_ENABLED=false
SEO_AI_PROVIDER=anthropic          # anthropic (default, already wired) | gemini
SEO_AI_MODEL=claude-haiku-4-5      # if gemini -> gemini-2.0-flash
ANTHROPIC_API_KEY=                 # required when provider=anthropic
GEMINI_API_KEY=                    # required when provider=gemini
