NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Database
GATEWAY_DATABASE_URL=postgresql://gateway_user:gateway_pass@localhost:5432/gateway_db?schema=public

# Redis (BullMQ + Pub/Sub + Rate limiter)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace-with-32-byte-random-secret-please
JWT_REFRESH_SECRET=replace-with-32-byte-random-secret-please

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# gRPC service URLs
CRAWLER_GRPC_URL=localhost:50051
ANALYZER_GRPC_URL=localhost:50053
KEYWORD_GRPC_URL=localhost:50054
REPORT_GRPC_URL=localhost:50055

# ── Public API LLM enrichment (/public/check → powers extension + CLI) ──
# enrichMode=llm asks the provider for per-issue AI fix suggestions.
# SEO_AI_ENABLED is a kill switch: unless it is exactly "true", enrichment
# degrades to template (meta.degraded=true, banner "Template fallback").
# Mirrors the report service's SEO_AI_* wiring so one env set drives both.
SEO_AI_ENABLED=false
SEO_AI_PROVIDER=gemini
SEO_AI_MODEL=gemini-2.5-flash
# Set the key matching SEO_AI_PROVIDER (gemini → GEMINI_API_KEY,
# anthropic → ANTHROPIC_API_KEY). The unused one can stay blank.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Output token budget. Keep >=8192: /public/check sends ALL page issues in
# one call; 2048 truncates the JSON for ~15+ issues -> parse fails -> degrade.
LLM_MAX_TOKENS=8192

# Subscriptions / VietQR / Casso
VIETQR_BANK_BIN=970423
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
CASSO_WEBHOOK_SECRET=
BILLING_INTENT_TTL_MINUTES=30
BILLING_FEATURE_ENABLED=false

# API key device-binding (post-rollout default)
# off     — bind logic disabled, no header read, no log (kill switch)
# log     — read X-Install-Id, bind on first use, LOG mismatches but allow them through
# enforce — read X-Install-Id, bind on first use, REJECT mismatches with 401 KEY_INSTALL_MISMATCH
# See docs/superpowers/specs/2026-06-11-api-key-device-bind-design.md §10 for rollout phases.
API_KEY_INSTALL_BIND_MODE=enforce
