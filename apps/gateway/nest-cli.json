{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      { "include": "infra/prisma/generated/**/*", "watchAssets": true },
      { "include": "public-api/prompts/**/*.yaml", "watchAssets": true }
    ]
  }
}
