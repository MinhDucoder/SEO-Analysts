datasource db {
  provider = "postgresql"
  url      = env("GATEWAY_DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/infra/prisma/generated"
  binaryTargets = ["native"]
}

enum UserRole {
  user
  admin
}

enum AuditStatus {
  pending
  crawling
  analyzing
  reporting
  completed
  failed
}

enum AuditMode {
  single
  site
}

enum AlertType {
  score_drop
  new_issues
  site_down
}

enum ApiKeyEnvironment {
  live
  test
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  passwordHash  String?  @map("password_hash") @db.VarChar(255)
  fullName      String   @map("full_name") @db.VarChar(100)
  role          UserRole @default(user)
  isVerified    Boolean  @default(false) @map("is_verified")
  isLocked      Boolean  @default(false) @map("is_locked")
  oauthProvider String?  @map("oauth_provider") @db.VarChar(50)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens   RefreshToken[]
  audits          Audit[]
  scheduledAudits ScheduledAudit[]
  apiKeys         ApiKey[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_rt_user")
  @@index([tokenHash], name: "idx_rt_token")
  @@index([expiresAt], name: "idx_rt_expires")
  @@map("refresh_tokens")
}

model Audit {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String      @map("user_id") @db.Uuid
  url                   String      @db.Text
  domain                String      @db.VarChar(255)
  status                AuditStatus @default(pending)
  mode                  AuditMode   @default(single)
  seoScore              Decimal?    @map("seo_score") @db.Decimal(5, 2)
  targetKeyword         String?     @map("target_keyword") @db.VarChar(255)
  errorMessage          String?     @map("error_message") @db.Text
  crawlerType           String?     @map("crawler_type") @db.VarChar(20)
  crawlDurationMs       Int?        @map("crawl_duration_ms")
  discoveredUrlsCount   Int?        @map("discovered_urls_count")
  auditedUrlsCount      Int?        @map("audited_urls_count")
  completedAt           DateTime?   @map("completed_at") @db.Timestamptz
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageAudits PageAudit[]
  alerts     AuditAlert[]

  @@index([userId, createdAt(sort: Desc)], name: "idx_audits_user_created")
  @@index([domain], name: "idx_audits_domain")
  @@index([status], name: "idx_audits_status")
  @@map("audits")
}

/// One row per URL crawled inside a SITE-mode audit. For SINGLE-mode
/// audits this table stays empty; the Audit row itself holds the score.
model PageAudit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auditId   String   @map("audit_id") @db.Uuid
  url       String   @db.Text
  score     Int
  issues    Json     @default("[]") @db.JsonB
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId], name: "idx_page_audits_audit")
  @@index([score], name: "idx_page_audits_score")
  @@map("page_audits")
}

/// F2 — one row per recurring audit schedule owned by a user.
/// Cron string is validated at the API layer; BullMQ's Job Scheduler
/// (upsertJobScheduler) is the source of truth for next-fire times.
model ScheduledAudit {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  url           String    @db.Text
  cron          String    @db.VarChar(255)
  mode          AuditMode @default(single)
  maxUrls       Int?      @map("max_urls")
  targetKeyword String?   @map("target_keyword") @db.VarChar(255)
  lastRunAt     DateTime? @map("last_run_at") @db.Timestamptz
  lastScore     Int?      @map("last_score")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts AuditAlert[]

  @@index([userId], name: "idx_scheduled_audits_user")
  @@index([isActive], name: "idx_scheduled_audits_active")
  @@map("scheduled_audits")
}

/// F2 — emitted by the regression detector when a scheduled audit
/// reports a worse score than the previous run, or when a site goes
/// down. `scheduleId` is nullable so one-off audits can also emit.
model AuditAlert {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auditId    String    @map("audit_id") @db.Uuid
  scheduleId String?   @map("schedule_id") @db.Uuid
  type       AlertType
  deltaScore Int?      @map("delta_score")
  message    String    @db.Text
  sentAt     DateTime? @map("sent_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  audit    Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  schedule ScheduledAudit? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([auditId], name: "idx_audit_alerts_audit")
  @@index([scheduleId], name: "idx_audit_alerts_schedule")
  @@index([createdAt], name: "idx_audit_alerts_created")
  @@map("audit_alerts")
}

/// Public API key owned by a user. Plaintext is returned ONCE at creation
/// and never stored; only sha256(plaintext) is kept in `hashedKey`.
/// Consumers call /api/v1/public/* with `Authorization: Bearer sk_live_...`.
model ApiKey {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  name        String            @db.VarChar(100)
  prefix      String            @db.VarChar(20)
  hashedKey   String            @unique @map("hashed_key") @db.VarChar(64)
  environment ApiKeyEnvironment @default(live)
  lastUsedAt  DateTime?         @map("last_used_at") @db.Timestamptz
  lastUsedIp  String?           @map("last_used_ip") @db.Inet
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz
  expiresAt   DateTime?         @map("expires_at") @db.Timestamptz
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageDaily UsageDaily[]

  @@index([hashedKey], name: "idx_api_keys_hashed_key")
  @@index([userId, revokedAt], name: "idx_api_keys_user_active")
  @@map("api_keys")
}

/// Rolled up nightly from Redis counters. Powers /settings/usage page +
/// admin abuse detection. Today's counts live in Redis until rollup.
model UsageDaily {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  apiKeyId     String   @map("api_key_id") @db.Uuid
  date         DateTime @db.Date
  requests     Int      @default(0)
  llmCalls     Int      @default(0) @map("llm_calls")
  llmTokensIn  Int      @default(0) @map("llm_tokens_in")
  llmTokensOut Int      @default(0) @map("llm_tokens_out")
  bytesIn      Int      @default(0) @map("bytes_in")
  bytesOut    Int      @default(0) @map("bytes_out")
  errors       Int      @default(0)
  cacheHits    Int      @default(0) @map("cache_hits")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, date], name: "usage_daily_key_date_uniq")
  @@index([date], name: "idx_usage_daily_date")
  @@map("usage_daily")
}
