@startuml 01-erd
' Figure 2.1 — Entity Relationship Diagram
!pragma layout smetana

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #0F4761
skinparam ArrowThickness 1.3

skinparam class {
  BackgroundColor #F6F8FB
  BorderColor #0F4761
  BorderThickness 1.5
  FontColor #0F4761
  FontStyle bold
  FontSize 13
  AttributeFontColor #333333
  AttributeFontSize 11
}
hide circle

title Figure 2.1 — Database Entity Relationship Diagram

class users {
  + **id** : UUID «PK»
  --
  + email : VARCHAR(255) «UQ»
  + password_hash : VARCHAR(255)
  + role : ENUM(user, admin)
  + status : ENUM(active, locked)
  + full_name : VARCHAR(255)
  + avatar_url : VARCHAR(500)
  + created_at : TIMESTAMPTZ
  + updated_at : TIMESTAMPTZ
}

class audits {
  + **id** : UUID «PK»
  --
  + user_id : UUID «FK»
  + url : VARCHAR(2048)
  + status : ENUM
  + total_score : INT
  + error_message : TEXT
  + created_at : TIMESTAMPTZ
  + completed_at : TIMESTAMPTZ
}

class audit_results {
  + **id** : UUID «PK»
  --
  + audit_id : UUID «FK»
  + rule_id : VARCHAR(64)
  + score : INT (0-100)
  + severity : ENUM
  + details : JSONB
  + suggestions : TEXT[]
  + created_at : TIMESTAMPTZ
}

class keywords {
  + **id** : UUID «PK»
  --
  + audit_id : UUID «FK»
  + keyword : VARCHAR(255)
  + frequency : INT
  + density : DECIMAL(5,2)
  + position : INT
}

class rules {
  + **id** : VARCHAR(64) «PK»
  --
  + name : VARCHAR(255)
  + category : VARCHAR(64)
  + weight : INT (1-10)
  + enabled : BOOLEAN
  + description : TEXT
}

class refresh_tokens {
  + **id** : UUID «PK»
  --
  + user_id : UUID «FK»
  + token_hash : VARCHAR(255)
  + expires_at : TIMESTAMPTZ
  + revoked_at : TIMESTAMPTZ
}

users "1" --o{ "*" audits : has many
users "1" --o{ "*" refresh_tokens : has many
audits "1" --o{ "*" audit_results : has many
audits "1" --o{ "*" keywords : has many
rules "1" ..o{ "*" audit_results : references

@enduml
