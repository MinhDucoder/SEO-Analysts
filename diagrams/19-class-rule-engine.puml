!include _style.iuml
scale max 1920 width

title Figure 2.19 — SEO Rule Engine\n(Strategy Pattern — 20 Rules)

' ===== Core Interface =====
interface ISeoRule <<interface>> {
  + {abstract} id : string
  + {abstract} category : RuleCategory
  + check(pageData: PageData, keyword?: string) : RuleCheckOutput
}

class RuleCheckOutput <<value object>> {
  status : 'pass' | 'warn' | 'fail'
  score : 0 | 50 | 100
  message : string
  suggestion : string | null
  metadata : Record<string, any>
}

' ===== Core Services =====
class RuleRegistry <<service>> {
  - rules : Map<string, ISeoRule>
  + register(rule: ISeoRule) : void
  + getEnabled() : ISeoRule[]
  + getByCategory(cat: RuleCategory) : ISeoRule[]
}

class RuleRunner <<service>> {
  - registry : RuleRegistry
  + runAll(pageData, rules[]) : RuleResult[]
  - runSingle(rule, pageData) : RuleResult
}

class ScoreCalculator <<service>> {
  + weightedAverage(results[]) : number
  + classify(score) : string
  + calcCategoryScores(results[]) : CategoryScore[]
}

' ===== Enums =====
enum RuleCategory {
  META
  HEADINGS
  IMAGES
  LINKS
  PERFORMANCE
  TECHNICAL
}

enum CheckStatus {
  PASS = 100
  WARN = 50
  FAIL = 0
}

' ===== META Rules (4) =====
package "META Rules (weight sum: 23)" as META #E8F5E9 {
  class TitleTagRule {
    id = "title_tag"
    weight = 8
    --
    PASS: 50-60 chars
    WARN: 30-49 or 61-70
    FAIL: missing/<30/>70
  }
  class MetaDescriptionRule {
    id = "meta_description"
    weight = 7
    --
    PASS: 120-160 chars
    WARN: 80-119 or 161-200
    FAIL: missing/<80/>200
  }
  class OpenGraphRule {
    id = "open_graph"
    weight = 5
    --
    PASS: og:title+desc+image
    WARN: 1-2 present
    FAIL: none
  }
  class TwitterCardRule {
    id = "twitter_card"
    weight = 3
    --
    PASS: twitter:card present
    FAIL: missing
  }
}

' ===== HEADINGS Rules (2) =====
package "HEADINGS Rules (weight sum: 14)" as HEAD #E3F2FD {
  class H1TagRule {
    id = "h1_tag"
    weight = 8
    --
    PASS: exactly 1 H1 + keyword
    WARN: 1 H1 no keyword
    FAIL: 0 or >1 H1
  }
  class HeadingHierarchyRule {
    id = "heading_hierarchy"
    weight = 6
    --
    PASS: correct H1>H2>H3
    WARN: minor skip (H2>H4)
    FAIL: no headings/major issues
  }
}

' ===== IMAGES Rules (2) =====
package "IMAGES Rules (weight sum: 12)" as IMG #FFF8E1 {
  class ImageAltRule {
    id = "image_alt"
    weight = 7
    --
    PASS: >90% have alt
    WARN: 70-90% have alt
    FAIL: <70% have alt
  }
  class ImageOptimizationRule {
    id = "image_optimization"
    weight = 5
    --
    PASS: all <200KB, modern fmt
    WARN: some oversized
    FAIL: many issues
  }
}

' ===== LINKS Rules (2) =====
