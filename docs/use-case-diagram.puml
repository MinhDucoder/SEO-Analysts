@startuml SEO_Analyst_Platform_UseCase
' ============================================================
'  SEO ANALYST PLATFORM - USE CASE DIAGRAM
'  Version: 1.1
' ============================================================

left to right direction

' --- Theme & Styling ---
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam handwritten false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

skinparam actor {
  BackgroundColor #E8EAF6
  BorderColor #3F51B5
  FontColor #1A237E
  FontStyle bold
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #263238
  BorderThickness 1.5
  ArrowColor #546E7A
}

skinparam rectangle {
  BackgroundColor #F5F5F5
  BorderColor #B0BEC5
  FontColor #37474F
  FontStyle bold
  RoundCorner 15
  BorderThickness 2
}

skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #CFD8DC
  FontColor #546E7A
  FontStyle italic
  BorderStyle dashed
}

skinparam arrow {
  Color #78909C
  FontColor #78909C
  FontSize 10
}

' ============================================================
'  ACTORS
' ============================================================

actor "Guest" as Guest #E3F2FD;line:1565C0
actor "User" as User #E8F5E9;line:2E7D32
actor "Admin" as Admin #FFF3E0;line:E65100
actor "System\n(Background)" as System #F3E5F5;line:7B1FA2

' Ke thua: User lam duoc moi thu Guest lam
Guest <|-- User

' ============================================================
'  SYSTEM BOUNDARY
' ============================================================

rectangle "SEO Analyst Platform" {

  ' ----------------------------------------------------------
  '  AUTHENTICATION
  ' ----------------------------------------------------------
  package "Authentication" as auth_pkg {
    usecase "UC-01\nRegister Account" as UC01 #E3F2FD
    usecase "UC-02\nLogin / Google OAuth" as UC02 #E3F2FD
  }

  ' ----------------------------------------------------------
  '  CORE AUDIT (main flow)
  ' ----------------------------------------------------------
  package "SEO Audit" as audit_pkg {
    usecase "UC-03\nSubmit URL\n& Start Audit" as UC03 #E8F5E9
    usecase "UC-04\nView Real-time\nProgress" as UC04 #E8F5E9
    usecase "UC-05\nView SEO\nAnalysis Result" as UC05 #E8F5E9
    usecase "UC-06\nView Audit\nHistory" as UC06 #E8F5E9
    usecase "UC-07\nRetry Failed\nAudit" as UC07 #E8F5E9
  }

  ' ----------------------------------------------------------
  '  REPORT & COMPARISON
  ' ----------------------------------------------------------
  package "Report & Comparison" as report_pkg {
    usecase "UC-08\nExport PDF\nReport" as UC08 #FFF8E1
    usecase "UC-09\nShare Report\nLink" as UC09 #FFF8E1
    usecase "UC-10\nCompare Audit\nResults" as UC10 #FFF8E1
  }

  ' ----------------------------------------------------------
  '  ACCOUNT MANAGEMENT
  ' ----------------------------------------------------------
  package "Account" as account_pkg {
    usecase "UC-11\nManage Profile" as UC11 #F3E5F5
    usecase "UC-12\nDelete Audit" as UC12 #F3E5F5
  }

  ' ----------------------------------------------------------
  '  ADMINISTRATION
  ' ----------------------------------------------------------
  package "Administration" as admin_pkg {
    usecase "UC-13\nManage Users" as UC13 #FFF3E0
    usecase "UC-14\nView System\nDashboard" as UC14 #FFF3E0
  }

  ' ----------------------------------------------------------
  '  BACKGROUND JOBS (System)
  ' ----------------------------------------------------------
  package "Background Jobs" as bg_pkg {
    usecase "UC-15\nAuto Crawl\n& Analyze" as UC15 #F3E5F5
    usecase "UC-16\nCleanup Old\nAudits" as UC16 #F3E5F5
  }
}

' ============================================================
'  ACTOR --> USE CASE ASSOCIATIONS
' ============================================================

' --- Guest (limited access) ---
Guest --> UC01
Guest --> UC02
Guest --> UC03 #1565C0 : limited rules

' --- User (full access) ---
User --> UC03
User --> UC04
User --> UC05
User --> UC06
User --> UC07
User --> UC08
User --> UC09
User --> UC10
User --> UC11
User --> UC12

' --- Admin ---
Admin --> UC13
Admin --> UC14

' --- System ---
System --> UC15
System --> UC16

' ============================================================
'  RELATIONSHIPS: <<include>> (mandatory)
' ============================================================

' Submit audit -> trigger crawl
UC03 ..> UC15 : <<include>>

' Submit audit -> show progress
UC03 ..> UC04 : <<include>>

' Progress done -> show result
UC04 ..> UC05 : <<include>>

' History, Profile, Delete, Admin -> require login
UC06 ..> UC02 : <<include>>
UC11 ..> UC02 : <<include>>
UC12 ..> UC02 : <<include>>
UC13 ..> UC02 : <<include>>
UC14 ..> UC02 : <<include>>

' ============================================================
'  RELATIONSHIPS: <<extend>> (optional)
' ============================================================

' From result -> optional actions
UC05 ..> UC08 : <<extend>>
UC05 ..> UC09 : <<extend>>
UC05 ..> UC07 : <<extend>>

' From history -> optional compare
UC06 ..> UC10 : <<extend>>

' ============================================================
'  NOTES
' ============================================================

note right of UC03
  Guest: 10 rules, 3 audits/day
  User: 20 rules, 50 audits/day
end note

note right of UC15
  Pipeline:
  Crawl (Cheerio/Playwright)
  -> Analyze (20 SEO rules)
  -> Lighthouse (Core Web Vitals)
  -> Score & Rank
  -> Save to DB
end note

note bottom of UC16
  Auto cleanup:
  Guest audits > 7 days
  User audits > 90 days
end note

@enduml
